{
  "manifest_version": 3,
  "name": "Workspace01",
  "version": "1.0.0",
  "description": "Single-window workspace manager. Organize live tabs into named workspaces and switch between them without closing, recreating, or reloading tabs.",
  "homepage_url": "https://github.com/ntrezowan/workspace01-firefox",
  "permissions": [
    "tabs",
    "tabHide",
    "storage",
    "sessions"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "workspace01@remakr1.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Workspace01",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "theme_icons": [
      { "light": "icons/icon-night-48.png", "dark": "icons/icon-day-48.png", "size": 48 },
      { "light": "icons/icon-night-128.png", "dark": "icons/icon-day-128.png", "size": 128 }
    ]
  },
  "background": {
    "scripts": ["background.js"]
  },
  "incognito": "not_allowed"
}
